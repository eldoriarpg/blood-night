{
  "name": "bloodnight-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node scripts/pack.mjs && node scripts/self-hosting.mjs && node scripts/javadoc.mjs && docusaurus start --port 4001",
    "build": "node scripts/pack.mjs && node scripts/self-hosting.mjs && node scripts/javadoc.mjs && docusaurus build",
    "serve": "docusaurus serve --port 4001",
    "clear": "docusaurus clear",
    "generate": "node scripts/generate.mjs",
    "typecheck": "tsc",
    "pack": "node scripts/pack.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.0.0",
    "fflate": "^0.8.3",
    "typescript": "~7.0.0",
    "yaml": "^2.8.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "core-js": false,
    "@swc/core": false
  }
}
