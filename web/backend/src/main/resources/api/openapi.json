  "components" : {
    "schemas" : {
      "AddParticipant" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "areas" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/EditorArea"
            },
            "uniqueItems" : true
          }
        },
        "required" : [ "name", "areas" ]
      },
      "AppliedReport" : {
        "type" : "object",
        "properties" : {
          "revision" : {
            "type" : "integer"
          },
          "hashes" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "string"
            }
          }
        },
        "required" : [ "revision", "hashes" ]
      },
      "Catalog" : {
        "type" : "object",
        "properties" : {
          "format" : {
            "type" : "integer"
          },
          "version" : {
            "type" : "string"
          },
          "nodes" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/NodeType"
            }
          },
          "types" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/TypeInfo"
            }
          },
          "selectable" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "string"
            }
          },
          "bindings" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "string"
            }
          }
        },
        "required" : [ "format", "version", "nodes", "types", "selectable", "bindings" ]
      },
      "ChangeAccepted" : {
        "type" : "object",
        "properties" : {
          "revision" : {
            "type" : "integer"
          },
          "problems" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/PayloadProblem"
            }
          }
        },
        "required" : [ "revision", "problems" ]
      },
      "ChangeBatch" : {
        "type" : "object",
        "properties" : {
          "operations" : { }
        },
        "required" : [ "operations" ]
      },
      "ConfigInfo" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "type" : {
            "$ref" : "#/components/schemas/TypeRef"
          },
          "defaultValue" : { },
          "selects" : {
            "type" : "string"
          },
          "choices" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "beside" : {
            "type" : "string"
          }
        }
      },
      "CreateSession" : {
        "type" : "object",
        "properties" : {
          "catalog" : {
            "type" : "string"
          },
          "payload" : { },
          "participant" : {
            "type" : "string"
          },
          "areas" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/EditorArea"
            },
            "uniqueItems" : true
          }
        },
        "required" : [ "catalog", "payload", "participant", "areas" ]
      },
      "EditorArea" : {
        "type" : "string",
        "enum" : [ "MOBS", "MACROS", "ITEMS", "WORLDS", "SERVER", "DROPS" ]
      },
      "ErrorBody" : {
